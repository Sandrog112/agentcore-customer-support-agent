# Copy to .env (git-ignored) and fill in, then run commands with: uv run --env-file .env <command>
# Leave a variable empty to fall back to the default AWS credential chain.

# AWS credentials: prefer a named/SSO profile; use the key variables only for short-lived credentials.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Region for every AgentCore resource (e.g. us-east-1, us-west-2, eu-central-1).
AWS_REGION=

# Optional: Claude model on Amazon Bedrock (Messages API model id). Defaults to anthropic.claude-opus-5-5.
BEDROCK_MODEL_ID=
